# Public source RPC used only to create the disposable local fork.
RWA_SOURCE_RPC_URL=https://rpc.testnet.chain.robinhood.com

# Local Anvil endpoint and port used by scripts/m1-rwa-index.sh.
RWA_FORK_HOST=127.0.0.1
RWA_FORK_PORT=8545

# Optional. The public endpoint is non-archival, so only recent blocks may work.
# RWA_FORK_BLOCK_NUMBER=

# Setpoint Sandbox deployment (never commit a real value).
# PRIVATE_KEY is accepted as a compatibility alias for this variable.
SETPOINT_SANDBOX_DEPLOYER_KEY=0x...
RH_TESTNET_RPC=https://rpc.testnet.chain.robinhood.com
