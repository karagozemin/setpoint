RH_TESTNET_RPC=https://rpc.testnet.chain.robinhood.com
# Keep this only in your local environment; never commit or print it.
SETPOINT_SANDBOX_DEPLOYER_KEY=0x...
# The root deploy command also accepts PRIVATE_KEY as a compatibility alias.
# Optional; defaults to the deployer address.
SETPOINT_SANDBOX_ORACLE_UPDATER=0x...
# Private key for that updater, used only by sandbox:refresh-oracle.
SETPOINT_SANDBOX_ORACLE_UPDATER_KEY=0x...
